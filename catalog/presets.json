{
  "version": 1,
  "commentaire": "Presets des styles et univers (brief, section Paramètres). Fichier de référence ; copie embarquée dans app/assets/catalog/presets.json (test de synchronisation dans app/test/presets_test.dart). Les ids de filtres, motifs et fonds sont documentés dans renderer/PROTOCOL.md.",
  "styles": {
    "vintage": {
      "label": "Vintage",
      "filters": ["grain", "vignette", "sepia"],
      "transition": { "kind": "crossfade", "beats": 8 },
      "motifs": ["lightleak", "poussieres", "vumetre"]
    },
    "70s": {
      "label": "70's",
      "filters": ["warmth"],
      "transition": { "kind": "crossfade", "beats": 8 },
      "motifs": ["lightleak", "bokeh", "ticks"]
    },
    "punk": {
      "label": "Punk",
      "filters": ["photocopy", "glitch"],
      "transition": { "kind": "cut", "beats": 1 },
      "motifs": ["oscillo", "trame", "hud"]
    },
    "retrofutur": {
      "label": "Retrofutur",
      "filters": ["bloom", "chroma"],
      "transition": { "kind": "crossfade", "beats": 2 },
      "motifs": ["flare", "hud", "ticks"]
    },
    "vhs": {
      "label": "VHS",
      "filters": ["vhs", "chroma"],
      "transition": { "kind": "cut", "beats": 1 },
      "motifs": ["timecode", "tracking", "oscillo"]
    },
    "psyche": {
      "label": "Psyché",
      "filters": ["kaleido", "huerot", "bloom"],
      "transition": { "kind": "crossfade", "beats": 16 },
      "motifs": ["mandala", "fluide", "bokeh"]
    }
  },
  "universes": {
    "danse": {
      "label": "Danse",
      "backgrounds": ["danse-spots", "danse-disco", "danse-foule"],
      "pixabay": [
        "people dancing",
        "dancer silhouette",
        "disco party dance",
        "ballet dancer",
        "hip hop dance",
        "dancehall dance",
        "afro dance",
        "african dance",
        "sound system party",
        "reggae party",
        "party crowd dancing",
        "festival crowd night",
        "concert crowd"
      ],
      "note": "Remplace Campagne (2026-09-26) : boucles de danse dans des styles très variés. Les fonds shaders Campagne restent dans le moteur si on veut revenir en arrière."
    },
    "ville": {
      "label": "Ville",
      "backgrounds": ["ville-skyline", "ville-trafic", "ville-pluie"],
      "pixabay": ["city night traffic", "neon street", "skyline timelapse"]
    },
    "cosmos": {
      "label": "Cosmos",
      "backgrounds": ["cosmos-sun", "cosmos-stars", "cosmos-nebula", "cosmos-rings"],
      "pixabay": ["nebula space", "galaxy stars"]
    },
    "machines": {
      "label": "Machines",
      "backgrounds": ["machines-engrenages", "machines-pistons", "machines-circuits"],
      "pixabay": ["industrial machine", "gears mechanism", "factory robot"]
    },
    "nature": {
      "label": "Nature",
      "backgrounds": ["nature-eau", "nature-fumee", "nature-lucioles"],
      "pixabay": ["water surface ripples", "smoke slow motion", "forest canopy"]
    },
    "miroir": {
      "label": "Crazy AI",
      "backgrounds": ["miroir-kaleido", "miroir-chrome"],
      "note": "Caméra du téléphone au jalon 5 ; fonds génératifs en attendant."
    }
  }
}
