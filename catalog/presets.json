{
  "version": 3,
  "commentaire": "Presets des styles et univers (brief, section Paramètres). Fichier de référence ; copie embarquée dans app/assets/catalog/presets.json (test de synchronisation dans app/test/presets_test.dart). Les ids de filtres, motifs et fonds sont documentés dans renderer/PROTOCOL.md. Depuis le 2026-10-07 : chaque style porte un bassin d'effets vidéo séquencés par l'autopilote et des motifs PROCÉDURAUX uniquement (lasers, ondes de basses, trames… — plus d'images toutes faites ni boucles vidéo) ; chaque univers un bloc fx (gain = effets plus ou moins marqués, filters = filtres signatures mêlés au bassin du style).",
  "styles": {
    "vintage": {
      "label": "Vintage",
      "filters": ["grain", "vignette", "sepia", "warmth"],
      "transition": { "kind": "crossfade", "beats": 8 },
      "motifs": ["lightleak", "poussieres", "vumetre"]
    },
    "70s": {
      "label": "70's",
      "filters": ["warmth", "grain", "bloom", "hue"],
      "transition": { "kind": "crossfade", "beats": 8 },
      "motifs": ["lightleak", "bokeh", "ticks", "ondebasse"]
    },
    "punk": {
      "label": "Punk",
      "filters": ["photocopy", "glitch", "posterize", "vhs"],
      "transition": { "kind": "cut", "beats": 1 },
      "motifs": ["oscillo", "trame", "hud", "laser"]
    },
    "retrofutur": {
      "label": "Retrofutur",
      "filters": ["bloom", "chroma", "glitch", "posterize"],
      "transition": { "kind": "crossfade", "beats": 2 },
      "motifs": ["grid", "flare", "ticks", "laser", "ondebasse"]
    },
    "vhs": {
      "label": "VHS",
      "filters": ["vhs", "chroma", "grain", "glitch"],
      "transition": { "kind": "cut", "beats": 1 },
      "motifs": ["timecode", "tracking", "oscillo"]
    },
    "psyche": {
      "label": "Psyché",
      "filters": ["kaleido", "huerot", "bloom", "hue"],
      "transition": { "kind": "crossfade", "beats": 16 },
      "motifs": ["mandala", "fluide", "onde", "laser", "ondebasse"]
    }
  },
  "universes": {
    "danse": {
      "label": "Danse",
      "backgrounds": ["danse-spots", "danse-disco", "danse-foule"],
      "fx": { "gain": 1.1, "filters": ["bloom"] },
      "pixabay": [
        "people dancing",
        "dancer silhouette",
        "disco party dance",
        "ballet dancer",
        "hip hop dance",
        "dancehall dance",
        "afro dance",
        "african dance",
        "sound system party",
        "reggae party",
        "party crowd dancing",
        "festival crowd night",
        "concert crowd"
      ],
      "note": "Remplace Campagne (2026-09-26) : boucles de danse dans des styles très variés. Les fonds shaders Campagne restent dans le moteur si on veut revenir en arrière."
    },
    "ville": {
      "label": "Ville",
      "backgrounds": ["ville-skyline", "ville-trafic", "ville-pluie"],
      "fx": { "gain": 1.0, "filters": ["chroma"] },
      "pixabay": ["city night traffic", "neon street", "skyline timelapse"]
    },
    "cosmos": {
      "label": "Cosmos",
      "backgrounds": ["cosmos-sun", "cosmos-stars", "cosmos-nebula", "cosmos-rings"],
      "fx": { "gain": 0.9, "filters": ["bloom"] },
      "pixabay": ["nebula space", "galaxy stars"]
    },
    "machines": {
      "label": "Machines",
      "backgrounds": ["machines-engrenages", "machines-pistons", "machines-circuits"],
      "fx": { "gain": 1.2, "filters": ["posterize"] },
      "pixabay": ["industrial machine", "gears mechanism", "factory robot"]
    },
    "nature": {
      "label": "Nature",
      "backgrounds": ["nature-eau", "nature-fumee", "nature-lucioles"],
      "fx": { "gain": 0.8, "filters": ["vignette"] },
      "pixabay": ["water surface ripples", "smoke slow motion", "forest canopy"]
    },
    "miroir": {
      "label": "Crazy AI",
      "backgrounds": ["miroir-kaleido", "miroir-chrome"],
      "fx": { "gain": 1.3, "filters": ["kaleido", "glitch"] },
      "note": "Caméra du téléphone au jalon 5 ; fonds génératifs en attendant."
    }
  }
}
